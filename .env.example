# ---------------------------------------------------------------------------
# LLM provider: openai | anthropic | ollama | mock
# Default is "mock" so the project runs without an API key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# Model name. Leave empty to use the default for the provider:
#   openai -> gpt-4o-mini, anthropic -> claude-3-5-haiku-latest,
#   ollama -> llama3.1, mock -> mock-1
LLM_MODEL=

# API key. For OpenAI you may also use OPENAI_API_KEY,
# for Anthropic — ANTHROPIC_API_KEY.
LLM_API_KEY=

# Base URL override. Useful for OpenAI-compatible gateways or a local Ollama.
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com
#   ollama    -> http://localhost:11434
LLM_BASE_URL=

# Request timeout in seconds.
LLM_TIMEOUT=60

# Retries for timeouts / HTTP 429 / 5xx.
LLM_MAX_RETRIES=2

# Extra LLM calls allowed to fix schema or length violations.
LLM_MAX_REPAIRS=1

# Sampling temperature.
LLM_TEMPERATURE=0.2
